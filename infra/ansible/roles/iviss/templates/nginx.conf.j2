server {
    listen 80;
    server_name {{ domain_name | default('_') }};

    # --- Security Headers ---
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https:;" always;

    # Hide Nginx version
    server_tokens off;

    # --- Origin Verification for CloudFront ---
    # When CloudFront is enabled, reject requests without valid X-Origin-Verify header
    # This protects the origin from direct access bypassing the edge
    {% if cloudfront_enabled | default(false) %}
    set $origin_verify_valid 0;
    if ($http_x_origin_verify = "{{ cloudfront_origin_secret }}") {
        set $origin_verify_valid 1;
    }
    {% endif %}

    # Origin health check endpoint (no verification required)
    location = /__origin_check__ {
        return 204;
    }

    location / {
        {% if cloudfront_enabled | default(false) %}
        if ($origin_verify_valid = 0) {
            return 403;
        }
        {% endif %}
        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        {% if cloudfront_enabled | default(false) %}
        if ($origin_verify_valid = 0) {
            return 403;
        }
        {% endif %}
        proxy_pass http://localhost:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for API requests
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
    }
}
