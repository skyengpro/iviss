# ============================================
# IVISS Production Environment (Auto-generated by Ansible)
# ============================================

# PostgreSQL - Internal Database
POSTGRES_USER={{ db_user | default('iviss_user') }}
POSTGRES_PASSWORD={{ db_password | replace('$', '$$') }}
POSTGRES_DB={{ db_name | default('iviss_dev') }}

# PostgreSQL - External Database (placeholder)
EXTERNAL_POSTGRES_USER={{ db_user | default('iviss_user') }}
EXTERNAL_POSTGRES_PASSWORD={{ db_password | replace('$', '$$') }}
EXTERNAL_POSTGRES_DB={{ db_name | default('iviss_dev') }}
EXTERNAL_POSTGRES_HOST=iviss-db
EXTERNAL_POSTGRES_PORT=5432

# JWT Authentication
JWT_PRIVATE_KEY_PEM="{{ iviss_jwt_private_key_base64 | replace('$', '$$') }}"
JWT_PUBLIC_KEY_PEM="{{ iviss_jwt_public_key_base64 | replace('$', '$$') }}"
ACTIVATION_CODE_PEPPER="{{ activation_code_pepper | replace('$', '$$') }}"

# Backend Configuration
ENVIRONMENT={{ app_environment | default('staging') }}
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
RUST_LOG=info

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL={{ admin_bootstrap_email }}
ADMIN_BOOTSTRAP_PASSWORD={{ admin_bootstrap_password | replace('$', '$$') }}
ADMIN_BOOTSTRAP_PHONE={{ admin_bootstrap_phone }}
ADMIN_BOOTSTRAP_USERNAME={{ admin_bootstrap_username }}

# SMS Provider Configuration
SMS_PROVIDER={{ sms_provider | default('mock') }}
VONAGE_API_KEY={{ vonage_api_key | default('') | replace('$', '$$') }}
VONAGE_API_SECRET={{ vonage_api_secret | default('') | replace('$', '$$') }}
TWILIO_ACCOUNT_SID={{ twilio_account_sid | default('mock') | replace('$', '$$') }}
TWILIO_AUTH_TOKEN={{ twilio_auth_token | default('mock') | replace('$', '$$') }}
TWILIO_FROM_NUMBER={{ twilio_from_number | default('mock') | replace('$', '$$') }}

# Email Provider Configuration
EMAIL_PROVIDER={{ email_provider | default('mock') }}
RESEND_API_KEY={{ resend_api_key | default('') | replace('$', '$$') }}
RESEND_FROM_EMAIL={{ resend_from_email | default('') }}
SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default('') }}
SMTP_USERNAME={{ smtp_username | default('') }}
SMTP_PASSWORD="{{ smtp_password | default('') | replace('$', '$$') }}"
SMTP_FROM_EMAIL={{ smtp_from_email | default('') }}

# Shift configuration
SHIFT_START_HOUR={{ shift_start_hour | default('6') }}
SHIFT_END_HOUR={{ shift_end_hour | default('18') }}


