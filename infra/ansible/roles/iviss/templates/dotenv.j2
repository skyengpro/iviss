# ============================================
# IVISS Production Environment (Auto-generated by Ansible)
# ============================================

# Domain Configuration
DOMAIN_NAME="{{ domain_name }}"

# PostgreSQL - Internal Database
POSTGRES_USER="{{ db_user }}"
POSTGRES_PASSWORD="{{ db_password | replace('$', '$$') }}"
POSTGRES_DB="{{ db_name }}"

# PostgreSQL - External Database (placeholder)
EXTERNAL_POSTGRES_USER="{{ db_user }}"
EXTERNAL_POSTGRES_PASSWORD="{{ db_password | replace('$', '$$') }}"
EXTERNAL_POSTGRES_DB="{{ db_name }}"
EXTERNAL_POSTGRES_HOST="iviss-db"
EXTERNAL_POSTGRES_PORT="5432"

# JWT Authentication
JWT_PRIVATE_KEY_PEM="{{ jwt_private_key_pem | replace('$', '$$') }}"
JWT_PUBLIC_KEY_PEM="{{ jwt_public_key_pem | replace('$', '$$') }}"
ACTIVATION_CODE_PEPPER="{{ activation_code_pepper | replace('$', '$$') }}"

# Backend Configuration
ENVIRONMENT="{{ iviss_env }}"
SERVER_HOST="0.0.0.0"
SERVER_PORT="3000"
RUST_LOG="{{ log_level }}"

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL="{{ admin_bootstrap_email }}"
ADMIN_BOOTSTRAP_PASSWORD="{{ admin_bootstrap_password | replace('$', '$$') }}"
ADMIN_BOOTSTRAP_PHONE="{{ admin_bootstrap_phone }}"
ADMIN_BOOTSTRAP_USERNAME="{{ admin_bootstrap_username }}"

# SMS Provider Configuration
SMS_PROVIDER="{{ sms_provider }}"
VONAGE_API_KEY="{{ vonage_api_key | replace('$', '$$') }}"
VONAGE_API_SECRET="{{ vonage_api_secret | replace('$', '$$') }}"
TWILIO_ACCOUNT_SID="{{ twilio_account_sid | replace('$', '$$') }}"
TWILIO_AUTH_TOKEN="{{ twilio_auth_token | replace('$', '$$') }}"
TWILIO_FROM_NUMBER="{{ twilio_from_number | replace('$', '$$') }}"
ORANGE_CLIENT_ID="{{ orange_client_id | replace('$', '$$') }}"
ORANGE_CLIENT_SECRET="{{ orange_client_secret | replace('$', '$$') }}"
ORANGE_SENDER_NUMBER="{{ orange_sender_number | replace('$', '$$') }}"

# Email Provider Configuration
EMAIL_PROVIDER="{{ email_provider }}"
RESEND_API_KEY="{{ resend_api_key | replace('$', '$$') }}"
RESEND_FROM_EMAIL="{{ resend_from_email }}"
SMTP_HOST="{{ smtp_host }}"
SMTP_PORT="{{ smtp_port }}"
SMTP_USERNAME="{{ smtp_username }}"
SMTP_PASSWORD="{{ smtp_password | replace('$', '$$') }}"
SMTP_FROM_EMAIL="{{ smtp_from_email }}"

# Client Configuration
VITE_API_URL="{{ vite_api_url }}"

# Shift configuration
SHIFT_START_HOUR="{{ shift_start_hour }}"
SHIFT_END_HOUR="{{ shift_end_hour }}"
