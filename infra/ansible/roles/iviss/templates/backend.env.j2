DATABASE_URL=postgres://{{ db_username | default('iviss_user') }}:{{ db_password }}@iviss-db:5432/{{ db_name | default('iviss_prod') }}
EXTERNAL_DATABASE_URL=postgres://{{ db_username | default('iviss_user') }}:{{ db_password }}@iviss-db:5432/{{ db_name | default('iviss_prod') }}
SQLX_OFFLINE=true
ENVIRONMENT=production
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
RUST_LOG={{ rust_log | default('info') }}

# Authentication
JWT_SECRET="{{ jwt_secret }}"
JWT_PRIVATE_KEY_PEM="{{ jwt_private_key_pem }}"
JWT_PUBLIC_KEY_PEM="{{ jwt_public_key_pem }}"
ACTIVATION_CODE_PEPPER="{{ activation_code_pepper }}"

# Shift Configuration
SHIFT_START_HOUR={{ shift_start_hour | default(6) }}
SHIFT_END_HOUR={{ shift_end_hour | default(18) }}

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL="{{ admin_bootstrap_email }}"
ADMIN_BOOTSTRAP_PASSWORD="{{ admin_bootstrap_password }}"
ADMIN_BOOTSTRAP_PHONE="{{ admin_bootstrap_phone }}"
ADMIN_BOOTSTRAP_USERNAME="{{ admin_bootstrap_username }}"

# Twilio Configuration
TWILIO_ACCOUNT_SID="{{ twilio_account_sid | default('mock') }}"
TWILIO_AUTH_TOKEN="{{ twilio_auth_token | default('mock') }}"
TWILIO_FROM_NUMBER="{{ twilio_from_number | default('mock') }}"

# Postgres Container Env (Internal to docker-compose)
POSTGRES_USER={{ db_username | default('iviss_user') }}
POSTGRES_PASSWORD={{ db_password }}
POSTGRES_DB={{ db_name | default('iviss_prod') }}
