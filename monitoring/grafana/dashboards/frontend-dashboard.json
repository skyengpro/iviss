{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Frontend Availability",
      "description": "Heartbeat from frontend sessions — 1 means at least one active session",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "frontend_up",
          "legendFormat": "Frontend Status",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active Sessions",
      "description": "Number of concurrent browser sessions",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "frontend_active_sessions",
          "legendFormat": "Sessions",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Errors",
      "description": "Cumulative count of uncaught JS errors",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "frontend_errors_total",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Route Navigations",
      "description": "Total client-side route navigations",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "frontend_route_navigations_total",
          "legendFormat": "Navigations",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Page Load Duration",
      "description": "Page load time distribution from Navigation Timing API",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "frontend_page_load_duration_ms",
          "legendFormat": "Load Duration (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Errors Over Time",
      "description": "Rate of frontend errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "rate(frontend_errors_total[1m])",
          "legendFormat": "Errors/min",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Web Vitals — Largest Contentful Paint (LCP)",
      "description": "LCP measures loading performance. Good < 2500ms, Needs Improvement < 4000ms, Poor > 4000ms",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "max": 8000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2500
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "frontend_lcp_ms",
          "legendFormat": "LCP",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Web Vitals — First Input Delay (FID)",
      "description": "FID measures interactivity. Good < 100ms, Needs Improvement < 300ms, Poor > 300ms",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "max": 1000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "frontend_fid_ms",
          "legendFormat": "FID",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Web Vitals — Cumulative Layout Shift (CLS)",
      "description": "CLS measures visual stability. Good < 0.1, Needs Improvement < 0.25, Poor > 0.25",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "frontend_cls",
          "legendFormat": "CLS",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Route Navigations Over Time",
