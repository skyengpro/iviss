# ============================================
# IVISS Environment Configuration Example
# ============================================

# Domain Configuration
DOMAIN_NAME="yourdomain.com"

# PostgreSQL - Internal Database
POSTGRES_USER="iviss_user"
POSTGRES_PASSWORD="change_me_in_prod"
POSTGRES_DB="iviss_dev"

# JWT Authentication
# Use standard multi-line PEM format
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n..."
ACTIVATION_CODE_PEPPER="your_32_char_pepper_here"

# Vehicle API Endpoints variables
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_USERNAME=auth_api_username
EXTERNAL_API_PASSWORD=auth_api_password
EXTERNAL_API_LOCK_NDIA=header_lock_ndia
EXTERNAL_API_KINDIA=header_kindia
EXTERNAL_API_USER=header_user
EXTERNAL_API_CLIENT=header_client
EXTERNAL_API_CTR=header_ctr
EXTERNAL_API_TLS_CERT_B64=base64-encoded-pem-certificate

# Vehicle data cache (S3-compatible; MinIO for local Docker dev)
S3_CACHE_ENABLED=false
S3_CACHE_BUCKET=iviss-vehicle-cache
S3_CACHE_REGION=us-east-1
S3_CACHE_ENDPOINT_URL=http://iviss-minio:9000
S3_CACHE_FORCE_PATH_STYLE=true

# Backend Configuration
ENVIRONMENT="production"
SERVER_HOST="0.0.0.0"
SERVER_PORT="3000"
RUST_LOG="info"

# Frontend Configuration
VITE_API_URL="https://yourdomain.com"

# Admin Bootstrap (Runs on first startup)
ADMIN_BOOTSTRAP_EMAIL="admin@iviss.com"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe123!"
ADMIN_BOOTSTRAP_PHONE="+237000000000"
ADMIN_BOOTSTRAP_USERNAME="admin"

# SMS Provider Configuration (Options: mock, vonage, twilio)
SMS_PROVIDER="vonage"
VONAGE_API_KEY="your_key"
VONAGE_API_SECRET="your_secret"
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your_token"
TWILIO_FROM_NUMBER="+1..."

# Email Provider Configuration (Options: mock, resend, lettre)
EMAIL_PROVIDER="lettre"
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@resend.dev"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="user@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM_EMAIL="user@gmail.com"

# -------------------------------------------------
# 3) EMAIL PROVIDER (OPTIONAL FOR BOOT, REQUIRED FOR REAL EMAIL FLOWS)
# -------------------------------------------------
# Backend defaults to EMAIL_PROVIDER=mock if unset.
#
# For real org-admin provisioning email delivery, configure a real provider:
# - resend
# - lettre (SMTP)
# - smtp (alias of lettre)

EMAIL_PROVIDER=mock
OTP_VIA_EMAIL=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@iviss.cloud

# SMTP / Lettre (required when EMAIL_PROVIDER=lettre or smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@iviss.cloud

# -------------------------------------------------
# 4) LOCAL DEV OPTIONS
# -------------------------------------------------
# Seed sample data at startup: true | false
SEED_DATA=true

# Optional bootstrap admin account for first startup seed.
# Seed is skipped unless ALL values are provided.
ADMIN_BOOTSTRAP_EMAIL=admin@iviss.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe2026!
ADMIN_BOOTSTRAP_PHONE=+237600000000
ADMIN_BOOTSTRAP_USERNAME=admin

# NOTE ABOUT SHIFT_*:
# Organization working hours are now managed per-organization (start_work_time/end_work_time).
# These variables remain as compatibility values in compose and are not the primary source
# for org shift policy.
SHIFT_START_HOUR=6
SHIFT_END_HOUR=18

# Optional frontend override (only when needed)
VITE_API_URL=http://localhost:3000

# -------------------------------------------------
# 5) MONITORING (OPTIONAL LOCAL)
# -------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# -------------------------------------------------
# 6) PRODUCTION/DEPLOYMENT REFERENCE (NOT REQUIRED FOR LOCAL DEV)
# -------------------------------------------------
# These values are used by deployment workflows/scripts, not needed for standard local startup.

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1
# SSE-KMS: optional KMS key ARN for server-side encryption
S3_CACHE_KMS_KEY_ID=
# Client-side AES-256-GCM: optional base64-encoded 32-byte key.
S3_CACHE_ENCRYPTION_KEY=

GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-github-personal-access-token
DOCKER_ORG=skyengpro

DOMAIN_NAME=iviss.example.com
CERTBOT_EMAIL=admin@example.com
DB_PASSWORD=randomly-generated-if-left-empty

# --- Observability (OpenTelemetry) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=iviss-backend
