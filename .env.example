# ============================================
# IVISS Docker Compose Environment Variables
# ============================================
# Copy this file to .env and update values for your local development

# ----------------
# PostgreSQL - Internal Database (IVISS owned data)
# ----------------
POSTGRES_USER=iviss_user
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=iviss_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Vehicle API Endpoints variables
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_USERNAME=auth_api_username
EXTERNAL_API_PASSWORD=auth_api_password
EXTERNAL_API_LOCK_NDIA=header_lock_ndia
EXTERNAL_API_KINDIA=header_kindia
EXTERNAL_API_USER=header_user
EXTERNAL_API_CLIENT=header_client
EXTERNAL_API_CTR=header_ctr
EXTERNAL_API_TLS_CERT_B64=base64-encoded-pem-certificate
# ----------------
# JWT Authentication
# ----------------

# JWT RS256 keys (PEM)
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

ACTIVATION_CODE_PEPPER=your-super-secret-pepper-min-32-chars

# ----------------
# Rust Backend Configuration
# ----------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
RUST_LOG=info

# ----------------
# Frontend Configuration
# ----------------
# Optional: Only set this if the backend is hosted on a different domain/IP.
# Default is '/api' (relative path) for production.
VITE_API_URL=http://localhost:3000

# ----------------
# Development Options
# ----------------
# Set to 'debug' for verbose logging during development
# RUST_LOG=debug

# ----------------
# Monitoring (Prometheus + Grafana)
# ----------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# --------------------------------------------
# PRODUCTION DEPLOYMENT SECRETS (AWS Lightsail)
# --------------------------------------------
# These are used by infra/scripts/deploy.sh

# --- AWS Credentials ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# --- Initial Admin Account (Bootstrap) ---
ADMIN_BOOTSTRAP_EMAIL=admin@iviss.cloud
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe2026!
ADMIN_BOOTSTRAP_PHONE=+237600000000
ADMIN_BOOTSTRAP_USERNAME=admin

# --- SMS Provider Configuration ---
# Options: twilio, vonage, orange
SMS_PROVIDER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_NUMBER=

# --- Email Provider Configuration ---
# Options: mock, resend, smtp
EMAIL_PROVIDER=mock
OTP_VIA_EMAIL=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@iviss.cloud
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@iviss.cloud


# --- Registry Access (GHCR) ---
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-github-personal-access-token

# --- Infrastructure ---
DOMAIN_NAME=iviss.example.com
CERTBOT_EMAIL=admin@example.com
DB_PASSWORD=randomly-generated-if-left-empty
