# ============================================
# IVISS Local Development Environment Template
# ============================================
# Usage:
#   cp .env.example .env
#   then adjust values for your machine.
#
# Scope:
# - This file is optimized for LOCAL DEVELOPMENT with docker compose --profile dev.
# - Production/deployment variables are listed at the end as reference only.

# -------------------------------------------------
# 1) REQUIRED FOR LOCAL STARTUP (Docker Compose)
# -------------------------------------------------

# Internal PostgreSQL (IVISS-owned data)
POSTGRES_USER=iviss_user
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=iviss_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# External PostgreSQL placeholder (compose interpolation currently requires these)
# Note: External DB business integration may not be active yet, but this value must exist.
EXTERNAL_POSTGRES_USER=external_user
EXTERNAL_POSTGRES_PASSWORD=change-me-external-postgres-password
EXTERNAL_POSTGRES_DB=external_db
EXTERNAL_POSTGRES_HOST=localhost
EXTERNAL_POSTGRES_PORT=5432

# JWT RS256 keys (PEM string with \n)
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Security pepper (minimum 32 characters)
ACTIVATION_CODE_PEPPER=your-super-secret-pepper-min-32-chars

# Backend runtime
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Options: trace, debug, info, warn, error
LOG_LEVEL=info
# Options: local, staging, production
ENVIRONMENT=local

# -------------------------------------------------
# 2) SMS PROVIDER (REQUIRED BY BACKEND VALIDATION)
# -------------------------------------------------
# IMPORTANT:
# - SMS_PROVIDER must be one of: vonage, twilio, orange
# - The selected provider credentials must be non-empty or backend validation fails.
# - If you only need to boot locally, placeholder non-empty values are acceptable,
#   but OTP sending will fail against real providers.

SMS_PROVIDER=orange

# Vonage (required when SMS_PROVIDER=vonage)
VONAGE_API_KEY=placeholder-vonage-key
VONAGE_API_SECRET=placeholder-vonage-secret

# Twilio (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=placeholder-twilio-sid
TWILIO_AUTH_TOKEN=placeholder-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# Orange (required when SMS_PROVIDER=orange)
ORANGE_CLIENT_ID=placeholder-orange-client-id
ORANGE_CLIENT_SECRET=placeholder-orange-client-secret
ORANGE_SENDER_NUMBER=+237600000000

# -------------------------------------------------
# 3) EMAIL PROVIDER (OPTIONAL FOR BOOT, REQUIRED FOR REAL EMAIL FLOWS)
# -------------------------------------------------
# Backend defaults to EMAIL_PROVIDER=mock if unset.
#
# For real org-admin provisioning email delivery, configure a real provider:
# - resend
# - lettre (SMTP)
# - smtp (alias of lettre)

EMAIL_PROVIDER=mock

# Resend (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@iviss.cloud

# SMTP / Lettre (required when EMAIL_PROVIDER=lettre or smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@iviss.cloud

# -------------------------------------------------
# 4) LOCAL DEV OPTIONS
# -------------------------------------------------
# Seed sample data at startup: true | false
SEED_DATA=true

# Optional bootstrap admin account for first startup seed.
# Seed is skipped unless ALL values are provided.
ADMIN_BOOTSTRAP_EMAIL=admin@iviss.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe2026!
ADMIN_BOOTSTRAP_PHONE=+237600000000
ADMIN_BOOTSTRAP_USERNAME=admin

# NOTE ABOUT SHIFT_*:
# Organization working hours are now managed per-organization (start_work_time/end_work_time).
# These variables remain as compatibility values in compose and are not the primary source
# for org shift policy.
SHIFT_START_HOUR=6
SHIFT_END_HOUR=18

# Optional frontend override (only when needed)
VITE_API_URL=http://localhost:3000

# -------------------------------------------------
# 5) MONITORING (OPTIONAL LOCAL)
# -------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# -------------------------------------------------
# 6) PRODUCTION/DEPLOYMENT REFERENCE (NOT REQUIRED FOR LOCAL DEV)
# -------------------------------------------------
# These values are used by deployment workflows/scripts, not needed for standard local startup.

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-github-personal-access-token

DOMAIN_NAME=iviss.example.com
CERTBOT_EMAIL=admin@example.com
DB_PASSWORD=randomly-generated-if-left-empty
