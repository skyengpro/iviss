# ============================================
# IVISS Docker Compose Environment Variables
# ============================================
# Copy this file to .env and update values for your local development

# ----------------
# PostgreSQL - Internal Database (IVISS owned data)
# ----------------
POSTGRES_USER=iviss_user
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=iviss_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----------------
# PostgreSQL - External Database (National Vehicle Registry - Read-only)
# ----------------
EXTERNAL_POSTGRES_USER=external_user
EXTERNAL_POSTGRES_PASSWORD=change-me-external-postgres-password
EXTERNAL_POSTGRES_DB=external_db
EXTERNAL_POSTGRES_HOST=localhost
EXTERNAL_POSTGRES_PORT=5432

# ----------------
# JWT Authentication
# ----------------
JWT_SECRET=your_secure_jwt_secret_key_change_this_in_production

# JWT RS256 keys (PEM)
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

ACTIVATION_CODE_PEPPER=your-super-secret-pepper-min-32-chars

# ----------------
# Rust Backend Configuration
# ----------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
RUST_LOG=info

# ----------------
# Development Options
# ----------------
# Set to 'debug' for verbose logging during development
# RUST_LOG=debug

# ----------------
# Monitoring (Prometheus + Grafana)
# ----------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d


#  Shift hours — local time UTC+1 (Africa/Douala)
SHIFT_START_HOUR=6   # inclusive — agents can request OTP from 06:00
SHIFT_END_HOUR=18    # exclusive — last valid request at 17:59 
