# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/database_name
EXTERNAL_DATABASE_URL=postgres://username:password@localhost:5432/external_database_name

# JWT RS256 keys (PEM)
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Logging Configuration
# Options: trace, debug, info, warn, error
LOG_LEVEL=info

# Environment
# Options: local, staging, production
ENVIRONMENT=local
ACTIVATION_CODE_PEPPER=your-super-secret-pepper-min-32-chars

# SMS Provider Configuration
# Options: vonage, twilio, orange
SMS_PROVIDER=

# Vonage credentials (required if SMS_PROVIDER=vonage)
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret

# Twilio credentials (required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Orange Cameroun credentials (required if SMS_PROVIDER=orange)
# Get credentials at: https://developer.orange.com/apis/sms/getting-started
ORANGE_CLIENT_ID=your_orange_client_id
ORANGE_CLIENT_SECRET=your_orange_client_secret
ORANGE_SENDER_NUMBER=+237XXXXXXXXX

# Email Provider Configuration
# Options: mock, resend, lettre (or smtp)
EMAIL_PROVIDER=mock

# Resend credentials (required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMTP credentials (required if EMAIL_PROVIDER=lettre or smtp)
# For Gmail: Use port 465 with TLS (more reliable) or 587 with STARTTLS
# SMTP_PASSWORD must be an "App Password" (not your regular Gmail password)
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=your_email@gmail.com

# Generated Keys
# Shift hours — local time UTC+1 (Africa/Douala)
SHIFT_START_HOUR=6   # inclusive — agents can request OTP from 06:00
SHIFT_END_HOUR=18    # exclusive — last valid request at 17:59

# Admin Bootstrap Configuration
# These are used to create the initial admin user during migration.
# Only set these values in development/local environments!
# The password must be pre-hashed with argon2id format.
# You can generate a hash using: argon2 password -r -t 2 -m 19 -p 1
# Bootstrap admin (skipped if not set)
ADMIN_BOOTSTRAP_EMAIL=admin@iviss.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!2025
ADMIN_BOOTSTRAP_PHONE=+237600000000
ADMIN_BOOTSTRAP_USERNAME=admin