# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/database_name
EXTERNAL_DATABASE_URL=postgres://username:password@localhost:5432/external_database_name

# Redis db configuration
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# JWT RS256 keys (PEM)
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Logging Configuration
# Options: trace, debug, info, warn, error
LOG_LEVEL=info

# Environment
# Options: local, staging, production
ENVIRONMENT=local
ACTIVATION_CODE_PEPPER=your-super-secret-pepper-min-32-chars

# SMS Provider Configuration (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

